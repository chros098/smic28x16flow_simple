# Map generic RocketTile.gate.v onto SMIC40 std cells.
# Usage:
#   1) edit SMIC40_LIB to your .lib path
#   2) yosys -s map_smic40.ys
# Output: RocketTile.smic.gate.v

read_verilog ../../netlist/cdl/RocketTile.v
# convert all always-block processes back to FF cells (required, otherwise
# the netlist keeps behavioral always blocks that Innovus cannot parse)
proc
opt
techmap
opt
dfflibmap -liberty ../../scc40nll_vhsc40_lvt_tt_v1p1_25c_basic.lib
abc -liberty ../../scc40nll_vhsc40_lvt_tt_v1p1_25c_basic.lib
stat -liberty ../../scc40nll_vhsc40_lvt_tt_v1p1_25c_basic.lib
opt_clean
write_verilog -noattr ../../netlist/cdl/RocketTile.smic.gate.v
